{
  "compilerOptions": {
    "target": "ES2022",
    "module": "CommonJS",
    "moduleResolution": "node",
    "outDir": "./dist",
    "rootDir": "./src",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": false
  },
  "include": [
    "src/**/*"
  ],
  "exclude": [
    "src/App.tsx",
    "src/App.tsx.FRONTEND_ARTIFACT_BACKUP",
    "**/*.tsx",
    "node_modules",
    "src/App.tsx.FRONTEND*",
    "src/App.ts",
    "dist",
    "src/App.ts.FRONTEND_MOCK_BACKUP",
    "src/*.tsx.FRONTEND*",
    "src/App.tsx.FRONTEND_MOCK_BACKUP"
  ]
}