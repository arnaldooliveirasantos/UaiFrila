# UaiFrila — Pagamento, provedores, repasses e validação Pix
# Copiar estas variáveis para o .env da API e do worker (os dois usam WORKER_SECRET e API_URL).
# Gerar a chave de criptografia com:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"

# Chave AES-256-GCM (64 hex = 32 bytes) para criptografar segredos dos provedores no banco.
# OBRIGATÓRIA. Sem ela, salvar access token no admin dá erro explícito (nunca salva em texto puro).
PAGAMENTO_SEGREDO_CHAVE=f02030a12e5f0cedc7972f36f99f2e6009f9c299c1249a91b2311f444dca3489

# Segredo compartilhado API <-> worker, usado nos endpoints /api/interno/* (pagamentos e repasses).
# OBRIGATÓRIO e igual nos dois .env. Sem ele, o worker é ignorado.
WORKER_SECRET=f02030a12e5f0cedc7972f36f99f2e6009f9c299c1249a91b2311f444dca3489

# URL base da API, usada pelo worker para chamar os endpoints internos.
# Exemplo local: http://localhost:3000
API_URL=http://192.168.24.11:3000

# URL pública do webhook do Mercado Pago (opcional; se vazio, o MP não notifica e o worker faz polling).
# Exemplo: https://sua-api.com/api/pagamentos/webhook/MERCADO_PAGO
MP_WEBHOOK_URL=http://192.168.24.11:3000/api/pagamentos/webhook/MERCADO_PAGO

# E-mail pagador usado nos repasses via Mercado Pago (opcional).
MP_PAGADOR_EMAIL=pagamentos@uaifrila.com.br

# Efí — certificado mTLS (SÓ Efí). Caminhos no servidor onde estão o certificado e a chave.
EFI_CERT_PATH=/caminho/cert.pem
EFI_KEY_PATH=/caminho/chave.pem

# Efí — chave Pix de recebimento da conta Efí (SÓ Efí).
